{
  "name": "trastpiler",
  "version": "2.0.0",
  "description": "Agnostic transpiler for ASTs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgronKabashi/trastpiler"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "transpiler",
    "AST"
  ],
  "author": "Agron Kabashi",
  "license": "MIT",
  "dependencies": {
    "deepmerge": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.15"
  }
}
